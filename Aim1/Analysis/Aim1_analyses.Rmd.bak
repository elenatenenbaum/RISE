MAKE SURE TO REMOVE LONG VIDEOS and TRIM the extra frames

```{r video-timing}
video_time <- raw_data[grepl("test",raw_data$frame_id, ignore.case = T),]

options(digits.secs = 3)

video_time <- video_time %>%
  filter(key %in% c("eventType", "timestamp")) %>%
  tidyr::pivot_wider(
    names_from = key,
    values_from = value
  ) %>%
  dplyr::select(response_uuid, child_hashed_id, frame_id, event_number, eventType, timestamp) %>%
  tidyr::pivot_wider(
    names_from = eventType,
    values_from = timestamp
  ) %>%
  mutate(across(starts_with("exp-lookit"),
                ~ as.POSIXct(.x, format = "%Y-%m-%dT%H:%M:%OS", tz = "UTC")))

# pull the timestamps of startRecording, videoStarted, videoPaused from frame data

clean_df <- video_time %>% dplyr::select(1:3, `exp-lookit-video:startRecording`, `exp-lookit-video:videoStarted`, `exp-lookit-video:videoPaused`, `exp-lookit-video:trialCompleted`) %>%
  tidyr::pivot_longer(
    cols = starts_with("exp-lookit-video"),
    names_to = "event_type",
    values_to = "timestamp"
  ) %>%
  filter(!is.na(timestamp))%>%
  group_by(response_uuid, child_hashed_id, frame_id, event_type) %>%
  arrange(timestamp, .by_group = TRUE) %>%
  mutate(event_idx = row_number()) %>%
  ungroup()%>%
  mutate(
    event_type = if_else(
      event_idx == 1,
      event_type,
      paste0(event_type, "_", event_idx)
    )
  )%>%
  dplyr::select(response_uuid, child_hashed_id, frame_id, event_type, timestamp) %>%
  tidyr::pivot_wider(
    names_from = event_type,
    values_from = timestamp
  ) 

clean_df <- clean_df %>% 
  dplyr::select(1:3, `exp-lookit-video:startRecording`, `exp-lookit-video:videoStarted`,`exp-lookit-video:videoPaused`, `exp-lookit-video:videoStarted_2`,  `exp-lookit-video:videoPaused_2`, `exp-lookit-video:trialCompleted`)

# calculate the time (secs) between recording and started, and paused and restarted
df_diff <- clean_df %>%
  mutate(record_1ststart = (as.numeric(difftime(`exp-lookit-video:videoStarted`, `exp-lookit-video:startRecording`, units = "secs")))) 

```

```{r exclusions-video-quality-issues}
#videos that had video quality issues: glitching, frame repetition, or pixelation that need to be excluded
exclusion_df <- read.csv(file.path(main_dir, "Long_Video", "Aim1", "Aim1_total_frame_count_longvideo.csv"))
```


# Geometric Social 

Note on how outcome was derive:

1. Remove frames coded as "nobabyface", "noface", "none", or "away" 
2. Remove "left", "right" frames with confidence < 85%
3. Use "left" vs "right" to code "target" vs "non-target" depending on the task and version. Calculate % looking for each social side as:
 
    % looking =  (target) / (target + non-target)
    
    *left & right frames all need to have >= 85% confidence. A trial must have at least 33% usable data (i.e. left, right frames at 85% confidence) to be included.
    
```{r geosocial-stim-order}
GS<-Stim_Order %>% filter(grepl("Geo", value))
#merges participant order with icatcher output
GS_icatcher <- merge(x=GS,y=icatcher_output, 
             by=c("response_uuid","frame_id"), all=F) %>%
  anti_join(exclusion_df, by = c("response_uuid", "frame_id"))

GS_icatcher <- GS_icatcher %>% merge(df_diff) %>% mutate(
  frame_to_remove =
   round((record_1ststart * 1000) / 33.3)) %>% dplyr::select(1:6, frame_to_remove) %>% mutate(frame_to_remove = ifelse(is.na(frame_to_remove), 0, frame_to_remove))
```

```{r geosocial-timestamps}

Aim1_timestamps_final <- file.path(main_dir, "Timestamp", "Aim1", "Aim1_timestamps_final_October_2026.xlsx")

frame_ct_gs <- read_xlsx(
  Aim1_timestamps_final,
  sheet = "GeoSocial"
)
frame_ct_gs <- frame_ct_gs %>%
  mutate(frame = map2(`Frame Start` , `Frame End`, seq)) %>%
  tidyr::unnest(frame) %>%
  mutate(Trial = str_extract(`Trial Number`, "\\d+")) %>%
  dplyr::select(frame, Position, Trial) %>% dplyr::rename(position = Position)


frame_ct_gs <- frame_ct_gs %>%
  mutate(position = case_when(
    position == "left"  ~ "right",
    position == "right" ~ "left",
    TRUE ~ position
  ))
```

```{r geosocial-results}
GS_results <- process_icatcher(GS_icatcher, 
                               frame_ct_gs, 
                               Part_Age, 
                               use_version = F)

usable_frames <- GS_results$trial_counts %>%
  merge(GS_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    # NA noicatcherdata = no "no data" frames logged, so iCatcher data exists
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    noicatcherdata = tidyr::replace_na(noicatcherdata, 0),
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(GS_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(usable_frames,
          file.path(main_dir, "Computed_Data", "Aim1", "geosocial_usableframe.csv"),
          row.names = FALSE)
```

## Data count

Number (and percent) of infants who viewed the task at all (2nd column, as % of consented sample with any icatcher data & in frame data , with sufficient usable data (3rd column, as % of infants who viewed the task),  with fixation on a single side >80% of the task (4th column, as % of infants with usable data), and final N in the analytic dataset. 

```{r geosocial-data-count, fig.width=10}
GS_enrollment <- compute_gaze_metrics(
  GS_results,
  Part_Age,
  task_type = "dual",
  usable_threshold = 0.33,
  remove_fixations = TRUE,
  remove_extreme_target = TRUE,
  collapse_vpc_hh = FALSE,
  type_task = NULL,
  task_icatcher = NULL
)
```


```{r geosocial-table, fig.width=10}
make_flow_table(GS_results, GS_enrollment, Part_Age)
summarise_quality_v2(GS_results, Part_Age)
summarise_trials(GS_enrollment)
```


