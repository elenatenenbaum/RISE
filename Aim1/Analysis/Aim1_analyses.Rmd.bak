# Numeracy 

4 versions, participants sees ONLY small constant in 2 versions, and ONLY large constant in the other 2 versions.

Note on how outcome was derive:

1. Remove frames coded as "nobabyface", "noface", "none", or "away" 
2. Remove "left", "right" frames with confidence < 85%
3. Use "left" vs "right" to code "target" vs "non-target" depending on the task and version. Calculate % looking for each alternating/changing side as:
 
    % looking =  (target) / (target + non-target)
    
    *left & right frames all need to have >= 85% confidence. A trial must have at least 33% usable data (i.e. left, right frames at 85% confidence) to be included.

```{r numeracy-stim-order}
Numeracy<-Stim_Order %>% filter(grepl("Nume", value))

Numeracy_icatcher <- merge(x=Numeracy,y=icatcher_output, 
             by=c("response_uuid","frame_id"), all=FALSE) %>%
  anti_join(exclusion_df, by = c("response_uuid", "frame_id"))

Numeracy_icatcher <- Numeracy_icatcher %>% merge(df_diff) %>% mutate(
  frame_to_remove =
   round((record_1ststart * 1000) / 33.3)) %>% dplyr::select(1:6, frame_to_remove) %>% mutate(frame_to_remove = ifelse(is.na(frame_to_remove), 0, frame_to_remove))%>%
  mutate(value = gsub(".*/([^/]+)\\.webm$", "\\1", value))%>% 
  dplyr::mutate(value = gsub("_Aim1", "", value))


Numeracy_icatcher$Version<- Numeracy_icatcher$value
```

```{r numeracy-timestamps}
labeled_frames_numeracy <- read_xlsx(Aim1_timestamps_final,
  sheet = "Numeracy")

labeled_frames_numeracy <- labeled_frames_numeracy %>%
  mutate(Position = str_extract(Position, "Left|Right"))

labeled_frames_numeracy <- labeled_frames_numeracy %>%
  mutate(Position = case_when(
    Position == "Left"  ~ "right",
    Position == "Right" ~ "left",
    TRUE ~ Position
  ))


# Step 2: expand frame ranges into one row per frame
labeled_frames_numeracy <- labeled_frames_numeracy %>%
  rowwise() %>%
  mutate(frame = list(seq(`Frame Start`, `Frame End`))) %>%
  tidyr::unnest(frame) %>%
  ungroup() %>%
  dplyr::select(frame, Trial = `Trial Number`, Version, Position)

# Step 3: pivot so each version becomes its own column
labeled_frames_numeracy <- labeled_frames_numeracy %>%
  tidyr::pivot_wider(
    names_from  = Version,
    values_from = Position
  )
```

```{r numeracy-results}
numeracy_results <- process_icatcher(Numeracy_icatcher, 
                                     labeled_frames_numeracy, 
                                     Part_Age, 
                                     use_version = T)

numeracy_usable_frames <- numeracy_results$trial_counts %>%
  merge(numeracy_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(Numeracy_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(numeracy_usable_frames,
          file.path(main_dir, "Computed_Data", "Aim1", "numeracy_usableframe.csv"),
          row.names = FALSE)
```

```{r numeracy-enrollment, fig.width=10}
numeracy_enrollment <- compute_gaze_metrics(
    numeracy_results,
    Part_Age,
    task_type = c("dual"),
    usable_threshold = 0.33,
    remove_fixations = TRUE,
    remove_extreme_target = TRUE,
    collapse_vpc_hh = FALSE,
    type_task = NULL,
    task_icatcher = NULL
)
```

