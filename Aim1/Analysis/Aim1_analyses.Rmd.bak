  ) + 
  stat_n_text(size = 4, y.pos = 0) +
  theme_few() +
  geom_hline(yintercept = 0.5, linetype = "dashed", color = "red") +
  theme(
    text = element_text(size = 15),
    legend.position = "none"
    # axis.text.x = element_blank(),
    # axis.ticks.x = element_blank()
  )
