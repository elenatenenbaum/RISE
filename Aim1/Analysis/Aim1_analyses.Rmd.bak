# Word recognition

How outcome was derived:

Example of foot and milk (paired).
 
The word foot is the target in trial 1 and the distractor at trial 9.
the difference for foot = % looking at the word foot in trial 1 - % looking at the word foot in trial 9. Simplified:
 
foot_diff = trial1_target - trial9_distractor = trial1_target - (1 - trial9_target) = trial1_target + trial9_target - 1
 
But remember that the words are paired (these pairs are always shown together):
foot ~ milk
banana ~ hair
hand ~ yogurt
eyes ~ cookie
mouth ~ apple
 
The word milk then the target at trial 9 but the distractor at trial 1. So then for “milk”:
the difference for milk = % looking at the word milk in trial 9 - % looking at the word milk in trial 1. Simplified:
 
milk_diff = trial9_target – trial1_distractor = trial9_target - (1 - trial1_target) = trial9_target + trial1_target - 1
 
And then if you look at the math, foot_diff comes out to be the same as milk_diff (trial1_target + trial9_target – 1), so we just use this word-paired data once & we have 5 pairs in total. Kiddos will have up to 5 rows of final difference score.

The same thing repeats for trial 11 and trial 19.

Then the final data for foot ~ milk is: average %target - average %distractor = average of trial1_target & trial11_target - average of trial9_distractor & trial19_distractor. 


```{r word-rec-stim-order}
WL<-Stim_Order %>% filter(grepl("word", value))
WL_icatcher <- merge(x=WL,y=icatcher_output, 
             by=c("response_uuid","frame_id"), all=FALSE) %>%
  anti_join(exclusion_df, by = c("response_uuid", "frame_id"))

WL_icatcher <- WL_icatcher %>% merge(df_diff) %>% mutate(
  frame_to_remove =
   round((record_1ststart * 1000) / 33.3)) %>% dplyr::select(1:6, frame_to_remove) %>% mutate(frame_to_remove = ifelse(is.na(frame_to_remove), 0, frame_to_remove))
```

# Analysis 

```{r word-rec-timestamps}
# LABEL 
frame_ct_wl <- read_xlsx(Aim1_timestamps_final, sheet = "WordRecognition_Updated")

frame_ct_wl <- frame_ct_wl %>% 
  dplyr::mutate(Image = tolower(Image)) %>%
  tidyr::separate(Image, c("Image #1", "Image #2"), sep = ",") %>%
  dplyr::mutate(`Image #2` = trimws(`Image #2`))

frame_ct_wl_fin <- frame_ct_wl  %>% dplyr::mutate(Audio = word(Audio,-1)) %>% 
   dplyr::mutate(patterns = map_chr(strsplit(`Image #1`, " "),paste,collapse="|"),
          match = ifelse(str_detect(Audio, patterns), `Image #1`, `Image #2`)) %>% 
   dplyr::select(-patterns) %>%
  dplyr::mutate(target.location = word(match,-1))

WL_pair_1 <- frame_ct_wl_fin %>% mutate(Trial = row_number()) %>% dplyr::select(Trial, `Image #1`, match) %>% dplyr::relocate(Trial, .before = `Image #1`) %>% filter(Trial %in% c(1:10)) 


for(word in unique(WL_pair_1$`Image #1`)){
  WL_pair_1 <- WL_pair_1 %>% dplyr::mutate(TargTrial = ifelse(match == `Image #1`, Trial, NA)) %>%
                              dplyr::mutate(DistTrial = ifelse(match != `Image #1`, Trial, NA))
}

WL_pair_1_1 <- WL_pair_1 %>%
  dplyr::group_by(`Image #1`) %>%
  tidyr::fill(everything(), .direction = "down") %>%
  tidyr::fill(everything(), .direction = "up") %>%dplyr::slice(1)%>% arrange(Trial)  %>% dplyr::rename(Variable = `Image #1`)

WL_pair_1 <- frame_ct_wl_fin %>% mutate(Trial = row_number()) %>% dplyr::select(Trial, `Image #2`, match) %>% dplyr::relocate(Trial, .before = `Image #2`) %>% filter(Trial %in% c(1:10)) 


for(word in unique(WL_pair_1$`Image #2`)){
  WL_pair_1 <- WL_pair_1 %>% dplyr::mutate(TargTrial = ifelse(match == `Image #2`, Trial, NA)) %>%
                              dplyr::mutate(DistTrial = ifelse(match != `Image #2`, Trial, NA))
}

WL_pair_1_2 <- WL_pair_1 %>%
  dplyr::group_by(`Image #2`) %>%
   tidyr::fill(everything(), .direction = "down") %>%
   tidyr::fill(everything(), .direction = "up") %>% filter(Trial %in% c(6:10))%>% arrange(Trial) %>% dplyr::rename(Variable = `Image #2`)

WL_pair_part1 <- rbind(WL_pair_1_1[,-3], WL_pair_1_2[,-3])


WL_pair_2 <-frame_ct_wl_fin %>% mutate(Trial = row_number()) %>% dplyr::select(Trial, `Image #1`, match) %>% dplyr::relocate(Trial, .before = `Image #1`) %>% filter(Trial %in% c(11:20)) 


for(word in unique(WL_pair_2$`Image #1`)){
  WL_pair_2 <- WL_pair_2 %>% dplyr::mutate(TargTrial = ifelse(match == `Image #1`, Trial, NA)) %>%
                              dplyr::mutate(DistTrial = ifelse(match != `Image #1`, Trial, NA))
}

WL_pair_2_1 <- WL_pair_2 %>%
  dplyr::group_by(`Image #1`) %>%
   tidyr::fill(everything(), .direction = "down") %>%
   tidyr::fill(everything(), .direction = "up") %>%dplyr::slice(1)%>% arrange(Trial) %>% dplyr::rename(Variable = `Image #1`)

WL_pair_2 <- frame_ct_wl_fin %>% mutate(Trial = row_number()) %>% dplyr::select(Trial, `Image #2`, match) %>% dplyr::relocate(Trial, .before = `Image #2`) %>% filter(Trial %in% c(11:20)) 


for(word in unique(WL_pair_2$`Image #2`)){
  WL_pair_2 <- WL_pair_2 %>% dplyr::mutate(TargTrial = ifelse(match == `Image #2`, Trial, NA)) %>%
                              dplyr::mutate(DistTrial = ifelse(match != `Image #2`, Trial, NA))
}

WL_pair_2_2 <- WL_pair_2 %>%
  dplyr::group_by(`Image #2`) %>%
   tidyr::fill(everything(), .direction = "down") %>%
   tidyr::fill(everything(), .direction = "up") %>% filter(Trial %in% c(16:20)) %>% arrange(Trial)  %>% dplyr::rename(Variable = `Image #2`)

WL_pair_part2 <- rbind(WL_pair_2_1[,-3], WL_pair_2_2[,-3])

WL_item.pairs <- rbind(WL_pair_part1,WL_pair_part2) %>% arrange(TargTrial) %>% dplyr::select(-Trial) 

```

```{r word-rec-labeling}
labeled_frames_WL <- frame_ct_wl_fin %>%
  mutate(frame = map2(`Frame Start` , `Frame End`, seq)) %>%
  tidyr::unnest(frame) %>%
  mutate(Trial = str_extract(`Trial Number`, "\\d+")) %>%
  dplyr::select(frame, target.location, Trial) 

# KG2KG: labelled frames pulling from excel
# KG2KG: make another tab with the frames

#labeled_frames %>% group_by(Trial) %>% summarise(frame_start = min(frame), frame_end = max(frame)) %>% mutate(diff = frame_end - frame_start) %>% arrange(diff)


labeled_frames_WL <- labeled_frames_WL %>%
  mutate(target.location = case_when(
    target.location == "left"  ~ "right",
    target.location == "right" ~ "left",
    TRUE ~ target.location
  )) %>% dplyr::rename(position = target.location)


```

```{r word-rec-results}
# for model results
WL_results <- process_icatcher(WL_icatcher, 
                               labeled_frames_WL, 
                               Part_Age,
                               use_version = F)

usable_frames_wl <- WL_results$trial_counts %>%
  merge(WL_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(WL_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(usable_frames_wl,
          file.path(main_dir, "Computed_Data", "Aim1", "word_usableframe.csv"),
          row.names = FALSE)
```


Number (and percent) of infants who viewed the task at all (2nd column, as % of consented sample with any icatcher data & in frame data , with sufficient usable data (3rd column, as % of infants who viewed the task),  with fixation on a single side >80% of the task (4th column, as % of infants with usable data), and final N in the analytic dataset. 

```{r word-rec-enrollment, fig.width=10}
WL_enrollment <- compute_gaze_metrics(
  WL_results,
  Part_Age,
  task_type = "dual",
  usable_threshold = 0.33,
  remove_fixations = TRUE,
  remove_extreme_target = TRUE,
  collapse_vpc_hh = FALSE,
  type_task = NULL,
  task_icatcher = NULL
)
```


```{r word-rec-table, fig.width=10}
make_flow_table(WL_results, WL_enrollment, Part_Age)
summarise_quality_v2(WL_results, Part_Age)
summarise_trials(WL_enrollment)
```


```{r word-rec-difference-score, eval = T}
diff <- c()

for(i in c(1:20)){
 diff[[i]] <- WL_enrollment$metrics %>% 
   filter(Trial %in% WL_item.pairs[i,2:3]) %>% 
   mutate(distract_good = 1-target_prop) %>% 
   dplyr::select(1,Trial, distract_good, target_prop) %>% 
   dplyr::mutate(percent = ifelse(Trial == as.character(i), target_prop, distract_good)) %>%
   dplyr::mutate(Trial = ifelse(Trial == as.character(i), "target", "distractor")) %>%
   dplyr::select(response_uuid, Trial, percent) %>% tidyr::spread(Trial, percent) 
}
```

```{r word-rec-list-count}
df_list_count <- bind_rows(diff, .id = "Trial") %>% merge(WL_item.pairs[,2:3] %>% dplyr::rename(Trial = TargTrial)) %>% filter(!is.na(distractor) & !is.na(target)) %>% merge(Part_Age,all.x=TRUE)
```

```{r word-rec-item-pairs}
WL_item.pairs$Variable <- sub(" .*", "", WL_item.pairs$Variable)

df_list_diff_enroll <- bind_rows(diff, .id = "Trial") %>% 
  merge(WL_item.pairs[,1:2] %>% dplyr::rename(Trial = TargTrial)) %>% 
  filter(!is.na(distractor) & !is.na(target)) %>% 
  tidyr::pivot_longer(cols = c(distractor, target), names_to = "location", values_to = "percent") %>% 
  dplyr::group_by(response_uuid, Variable, location) %>% 
  dplyr::summarise(percent_2 = mean(percent)) %>% 
  tidyr::spread(key = location, value = percent_2) %>% 
  dplyr::mutate(diff = target - distractor) %>% 
  dplyr::rename(Word = Variable)  %>% 
  merge(Part_Age,all.x=TRUE)  %>% dplyr::mutate(Age = factor(Age, levels = c(6,12)))

df_list_diff_enroll <- df_list_diff_enroll %>% ungroup() %>% dplyr::mutate(Word_Pair = case_when(Word %in% c("foot", "milk") ~ "foot ~ milk",
                                                                       Word %in% c("banana", "hair") ~ "banana ~ hair",
                                                                       Word %in% c("hand", "yogurt") ~ "hand ~ yogurt",
                                                                       Word %in% c("eyes", "cookie") ~ "eyes ~ cookie",
                                                                       Word %in% c("mouth", "apple") ~ "mouth ~ apple"))  %>%
  group_by(response_uuid, Word_Pair, Age, cohort) %>%
  dplyr::slice(1) %>%
  ungroup()

# c("foot (milk)", "hair (banana)", "hand (yogurt)", "cookie (eyes)", "mouth (apple)
```

Final word recognition N (lower due to % target or % distractor is not available for the "difference" calculation)

```{r word-rec-list-diff-enroll}
df_list_diff_enroll %>% distinct() %>%
  dplyr::group_by(response_uuid)%>%
     summarise(n = n(), Age = first(Age)) %>% ungroup()%>% dplyr::select(Age, n)%>%
    tbl_summary(
      by   = Age,
      type = list(n ~ "continuous2"),
      statistic = list(
        all_continuous()  ~ c("{median} ({p25}, {p75})", "{min}, {max}"),
        all_categorical() ~ "{n} / {N} ({p}%)"
      ),
      digits       = all_continuous() ~ 2,
      missing_text = "(Missing)"
    ) %>% modify_caption("**Median (IQR) number of test trials with usable data (final analytic)**")
```

```{r word-rec-output}
write.csv(
    df_list_diff_enroll %>%
      dplyr::select(response_uuid, Age, Word_Pair,diff),
    file.path(main_dir, "Computed_Data", "Aim1", "word.csv"),
    row.names = FALSE
  )

tab_word <- run_condition_model(
    data = df_list_diff_enroll,
    condition_var = "Age",
    metric = "diff",
    chance_level = 0,
    random_effects = c(
        "(1 | response_uuid)",
        "(1 | Word_Pair)"
    ),
    interaction = FALSE
)

```

```{r word-rec-plot}
word_fig <- df_list_diff_enroll %>% dplyr::group_by(response_uuid) %>% dplyr::summarise(diff_good_avg = mean(diff)) %>% merge(Part_Age,all.x=TRUE)  %>% dplyr::select(response_uuid, Age, diff_good_avg)%>% dplyr::mutate(Age = factor(Age, levels = c(6, 12)))

# n per age group (non-missing scores, same as stat_n_text counted)
n_lab <- word_fig |>
  filter(!is.na(diff_good_avg)) |>
  count(Age)

plot5_rise <- ggplot(data = word_fig,
                     mapping = aes(x = Age,
                                   y = diff_good_avg,
                                   fill = Age)) +
  geom_flat_violin(scale = "count",
                   trim = FALSE) +
  stat_summary(fun.data = mean_sdl,
               fun.args = list(mult = 1),
               geom = "pointrange",
               position = position_nudge(0.05)) +
  geom_dotplot(binaxis = "y",
               dotsize = 0.6,
               stackdir = "down",
               position = position_nudge(-0.025)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
  # n labels sit below the violin tails (which reach about -1.0)
  geom_text(data = n_lab,
            aes(x = Age, y = -1.2, label = paste0("n=", n)),
            inherit.aes = FALSE, size = 4.5, vjust = 1) +
  # make room under the violins for the labels
  expand_limits(y = -1.4) +
  scale_fill_manual(values = c("darkolivegreen3", "darkolivegreen4")) +
  labs(x = "Age",
       y = "Average pair difference score \n(target - distractor)\n") +
  theme_few() +
  theme(text = element_text(size = 15)) +
  guides(fill = "none")

```

```{r word-rec-plot2}
word_fig_1 <- df_list_diff_enroll %>% dplyr::group_by(response_uuid) %>% dplyr::summarise(distractor_avg = mean(distractor), target_avg = mean(target)) %>% dplyr::select(response_uuid, distractor_avg, target_avg)

word_fig_long <- word_fig_1 %>%
