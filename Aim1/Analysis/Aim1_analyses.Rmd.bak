                               use_version = F)

usable_frames_av <- AV_results$trial_counts %>%
  merge(AV_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(AV_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(usable_frames_av,
          file.path(main_dir, "Computed_Data", "Aim1", "av_usableframe.csv"),
          row.names = FALSE)

```

