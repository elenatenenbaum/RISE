## Analysis

```{r numeracy-analysis}
type_num <- read_xlsx(
  Aim1_timestamps_final,
  sheet = "Numeracy") %>%
  dplyr::select(2:3)

df_numeracy_enrollment <- numeracy_enrollment$metrics %>% 
  merge(Numeracy_icatcher %>% dplyr::select(1, Version)) %>% 
  merge(type_num %>% distinct()) %>%
  dplyr::mutate(`Stimulus type` = ifelse(grepl("Large", `Stimulus type`), "Large Constant", "Small Constant")) %>%
  dplyr::mutate(`Stimulus type` = factor(`Stimulus type`, 
                                        levels = c("Small Constant", "Large Constant")))
```

```{r numeracy-output}
write.csv(
    df_numeracy_enrollment %>%
      dplyr::select(response_uuid, Age, Trial,target_prop, `Stimulus type`),
      file.path(main_dir, "Computed_Data", "Aim1", "numeracy.csv"),
    row.names = FALSE
  )

tab_num <- run_condition_model(
    data = df_numeracy_enrollment %>% dplyr::rename(Stimulus_type = `Stimulus type`),
    condition_var = c("Age" ,"Stimulus_type"),
    metric = "target_prop",
    chance_level = 0.5,
    random_effects = c(
        "(1 | response_uuid)",
        "(1 | Trial)"
    ),
    interaction = T
)%>% filter(!grepl("6 - 12", Condition))

```

