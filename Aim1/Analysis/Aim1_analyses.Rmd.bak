# VPC
8 versions, participants sees both object & face stimuli

Note on how outcome was derive:

1. Remove frames coded as "nobabyface", "noface", "none", or "away" 
2. Remove frames with with confidence < 85%
3. Use "left" vs "right" to code "target" vs "non-target" depending on the task and version. Calculate % looking for each novel side as:
 
    % looking =  (target) / (target + non-target)
    
    *left & right frames all need to have >= 85% confidence. A trial must have at least 33% usable data (i.e. left, right frames at 85% confidence) to be included.
    
```{r vpc-stim-order}
vpc<-Stim_Order %>% filter(grepl("VPC", value))
vpc_icatcher <- merge(x=vpc,y=icatcher_output, 
             by=c("response_uuid","frame_id"), all=F) %>%
  anti_join(exclusion_df, by = c("response_uuid", "frame_id"))

vpc_icatcher <- vpc_icatcher %>% merge(df_diff) %>% mutate(
  frame_to_remove =
   round((record_1ststart * 1000) / 33.3)) %>% dplyr::select(1:6, frame_to_remove) %>% mutate(frame_to_remove = ifelse(is.na(frame_to_remove), 0, frame_to_remove)) %>% 
  mutate(value = gsub(".*/([^/]+)\\.webm$", "\\1", value)) %>%
  dplyr::mutate(value = gsub("_Aim1", "", value))

vpc_icatcher$Version<- vpc_icatcher$value

```

```{r vpc-timestamps}

labeled_frames_vpc <- read_xlsx(
  Aim1_timestamps_final,
  sheet = "VPC"
)

labeled_frames_vpc <- labeled_frames_vpc %>%
  mutate(Position = str_extract(Position, "left|right"))

labeled_frames_vpc <- labeled_frames_vpc %>%
  mutate(Position = case_when(
    Position == "left"  ~ "right",
    Position == "right" ~ "left",
    TRUE ~ Position
  ))


# Step 2: expand frame ranges into one row per frame
labeled_frames_vpc <- labeled_frames_vpc %>%
  rowwise() %>%
  mutate(frame = list(seq(`Frame Start`, `Frame End`))) %>%
  tidyr::unnest(frame) %>%
  ungroup() %>%
  dplyr::select(frame, Trial = `Trial Number`, Version, Position)

# Step 3: pivot so each version becomes its own column
labeled_frames_vpc <- labeled_frames_vpc %>%
  tidyr::pivot_wider(
    names_from  = Version,
    values_from = Position
  )

```

```{r vpc-read-timstamps}
type_vpc <- read_xlsx(Aim1_timestamps_final,sheet = "VPC") %>%
  dplyr::select(1:3)

```

```{r vpc-results}
vpc_results <- process_icatcher(vpc_icatcher, 
                                labeled_frames_vpc, 
                                Part_Age,
                                use_version = T)

# main_dir must already be defined, e.g. main_dir <- "/path/to/project"
usable_frames_vpc <- vpc_results$trial_counts %>%
  merge(vpc_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    # NA noicatcherdata = no "no data" frames logged, so iCatcher data exists
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    noicatcherdata = tidyr::replace_na(noicatcherdata, 0),
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(vpc_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(usable_frames_vpc,
          file.path(main_dir, "Computed_Data", "Aim1", "vpc_usableframe.csv"),
          row.names = FALSE)
```

## Data count

Number (and percent) of infants who viewed the task at all (2nd column, as % of consented sample with any icatcher data & in frame data , with sufficient usable data (3rd column, as % of infants who viewed the task),  with fixation on a single side >80% of the task (4th column, as % of infants with usable data), and final N in the analytic dataset. 

```{r vpc-data-count, fig.width=10}
vpc_enrollment <- compute_gaze_metrics(
    vpc_results,
    Part_Age,
    task_type = c("dual"),
    usable_threshold = 0.33,
    remove_fixations = TRUE,
    remove_extreme_target = TRUE,
