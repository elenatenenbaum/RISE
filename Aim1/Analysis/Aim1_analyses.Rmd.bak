```{r all-files-loading, include=FALSE}
# ------------------------------------------------------------
# Load all R scripts from a folder
# ------------------------------------------------------------
main_dir <- "/Users/myvu/Library/CloudStorage/OneDrive-CHILDRENSHOSPITALLOSANGELES-BiostatsCore-StaffFiles/My Vu/Current_Sept32026/Elena Tenenbaum Updated"

setwd(main_dir)
base_dir <- file.path(main_dir, "Frame_Data", "Aim1")

read_session_folder <- function(subfolder, fix_event_number = FALSE) {
  files <- list.files(file.path(base_dir, subfolder), full.names = TRUE)
  df_list <- lapply(files, read_csv)
  
  if (fix_event_number) {
    # event_number is read as character in some files here; coerce before binding
    df_list <- lapply(df_list, function(d) {
      as.data.frame(d) %>% dplyr::mutate(event_number = as.numeric(event_number))
    })
  }
  
  bind_rows(df_list)
}

raw_data_1 <- read_session_folder("RISE-Study-Aim-1_framedata_per_session")
raw_data_2 <- read_session_folder("RISE-Study-Surveys_framedata_per_session", fix_event_number = TRUE)

raw_data <- bind_rows(raw_data_1, raw_data_2)

raw_data <- raw_data %>% distinct()

r_files <- list.files(
  path = file.path(main_dir, "Main_Functions"),
  pattern = "\\.R$",
  full.names = TRUE
)

invisible(lapply(r_files, source))
```

```{r id-file-loading}
id_merge <- read.csv(file.path(main_dir, "Enrollment_Log", "Aim1", "Aim1_final_correct_ID.csv"))

id_merge <- id_merge %>% filter(timepoint == "NT Baseline Enrollment" & cohort == "NT") %>%
  mutate(
    # Snap to whichever anchor is closer; midpoint is 9, so exactly 9.0 is a tie
    # (here ties go to 12 via `>=`; change to `>` to send 9.0 to 6)
    Age = if_else(Age >= 9, 12, 6)
  )
```


```{r icatcher-files-loading}
#imports annotated data from folder
files <- list.files(path = file.path(main_dir, "Annotation", "Aim1"), pattern = "\\.txt$", full.names = TRUE, recursive = T)  

icatcher_output <- tibble(icatcher_files = files, file = basename(files)) %>%
  mutate(
    # strip everything before "10-test...", "6-calibration...", "3-video..."
    icatcher_file_names = str_remove(file, "^.*?(?=\\d+-(test|calibration|video))"),
    
    # first two "_" pieces of the cleaned name
    frame_id      = str_split_i(icatcher_file_names, "_", 1),   # e.g. "10-test-trial-2"
    response_uuid = str_split_i(icatcher_file_names, "_", 2),   # e.g. "ad8986ae-..."
    
    # just number + type, so slightly different names group together
    task_id = str_extract(icatcher_file_names, "^\\d+-(test|calibration|video)"),
    
    # 13-digit epoch (ms) embedded in the filename
    ts_ms    = as.numeric(str_match(file, "_(\\d{13})_\\d+\\.txt$")[, 2]),
    recorded = as.POSIXct(ts_ms / 1000, origin = "1970-01-01", tz = "America/Los_Angeles"),
    modified = file.info(icatcher_files)$mtime
  ) %>%
  group_by(response_uuid, task_id) %>%
  mutate(n_versions = n()) %>%
  ungroup() %>%
  arrange(response_uuid, task_id, recorded) %>%
  dplyr::select(icatcher_files, icatcher_file_names, frame_id, response_uuid,
                task_id, recorded, modified, n_versions)

icatcher_output <- icatcher_output %>%
  group_by(response_uuid, task_id) %>%
  slice_max(modified, n = 1, with_ties = FALSE) %>%
  ungroup() %>% 
  filter(response_uuid %in% id_merge$response_uuid)
```

```{r stim-order}
Stim_Order<-raw_data[raw_data$key == "videoShown",]
#reduces to rows that contained "test"
Stim_Order<-Stim_Order[grep("test",Stim_Order$frame_id),]

