# Helper Hinderer
8 versions, participants sees both helper and hinderer. 

Note on how outcome was derive:

1. Remove frames coded as "nobabyface", "noface", "none", or "away" 
2. Remove "left", "right" frames with confidence < 85%
2. Use "left" vs "right" to code "target" vs "non-target" depending on the task and version. Calculate % looking for each helper side as:
 
    % looking =  (target) / (target + non-target)
    
    *left & right frames all need to have >= 85% confidence. A trial must have at least 33% usable data (i.e. left, right frames at 85% confidence) to be included.

```{r hh-stim-order}
hh<-Stim_Order %>% filter(grepl("condition", value))

hh_icatcher <- merge(x=hh,y=icatcher_output, 
             by=c("response_uuid","frame_id"), all=FALSE) %>%
  anti_join(exclusion_df, by = c("response_uuid", "frame_id"))

hh_icatcher <- hh_icatcher %>% merge(df_diff) %>% mutate(
  frame_to_remove =
   round((record_1ststart * 1000) / 33.3)) %>% dplyr::select(1:6, frame_to_remove) %>% mutate(frame_to_remove = ifelse(is.na(frame_to_remove), 0, frame_to_remove))%>%
  mutate(value = gsub(".*/([^/]+)\\.webm$", "\\1", value))%>% 
  dplyr::mutate(value = gsub("_Aim1", "", value))


hh_icatcher$Version<- hh_icatcher$value

```

```{r hh-timestamps}
labeled_frames_hh <- read_xlsx(Aim1_timestamps_final, sheet = "HelperHinderer")

labeled_frames_hh <- labeled_frames_hh %>%
  mutate(Position = str_extract(Position, "left|right"))

labeled_frames_hh <- labeled_frames_hh %>%
  mutate(Position = case_when(
    Position == "left"  ~ "right",
    Position == "right" ~ "left",
    TRUE ~ "habituation"
  ))


# Step 2: expand frame ranges into one row per frame
labeled_frames_hh <- labeled_frames_hh %>%
  rowwise() %>%
  mutate(frame = list(seq(`Frame Start`, `Frame End`))) %>%
  tidyr::unnest(frame) %>%
  ungroup() %>%
  dplyr::select(frame, Trial = `Trial Number`, Version, Position)

# Step 3: pivot so each version becomes its own column
labeled_frames_hh <- labeled_frames_hh %>%
  tidyr::pivot_wider(
    names_from  = Version,
    values_from = Position
  )
```

```{r hh-results}
hh_results <- process_icatcher(hh_icatcher, 
                                     labeled_frames_hh, 
                                     Part_Age, 
                                     use_version = T)

hh_usable_frames <- hh_results$trial_counts %>%
  merge(hh_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(hh_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(hh_usable_frames,
          file.path(main_dir, "Computed_Data", "Aim1", "hh_usableframe.csv"),
          row.names = FALSE)
```

```{r hh-enrollment, fig.width=10}
# look at the test trials only
hh_enrollment <- compute_gaze_metrics(
    hh_results,
    Part_Age,
    task_type = c("dual"),
    usable_threshold = 0.33,
    remove_fixations = TRUE,
    remove_extreme_target = TRUE,
    collapse_vpc_hh = FALSE,
    type_task = NULL,
    task_icatcher = NULL,
    trial_filter = c("7", "14")
)
```

## Data count

Number (and percent) of infants who viewed the task at all (2nd column, as % of consented sample with any icatcher data & in frame data , with sufficient usable data (3rd column, as % of infants who viewed the task),  with fixation on a single side >80% of the task (4th column, as % of infants with usable data), and final N in the analytic dataset. 


```{r hh-data-count, fig.width=10}
make_flow_table(hh_results, hh_enrollment, Part_Age)
summarise_quality_v2(hh_results, Part_Age)
summarise_trials(hh_enrollment)
```

For each block, a participant was required to have at least one usable helper trial and at least one hinderer trial (Block 1: trials 1–6; Block 2: trials 8–13), where usable trials were defined as having at least 33% of frames with valid iCatcher+ detections at ≥85% confidence.

```{r hh-includes}
data_include <- hh_results$trial_counts %>%
  dplyr::mutate(
    `Usable frames (%)` = round(count_85_non_na / frames, 3),
  ) %>%
  merge(Part_Age, all.x = TRUE) %>%
  filter(`Usable frames (%)` >= 0.33) %>%
  filter(!Trial %in% c("7", "14")) %>%
  mutate(Trial = as.numeric(Trial)) %>%
  group_by(response_uuid) %>%
  mutate(
    include_block1 = any(Trial[Trial %in% 1:6] %% 2 == 1) &
                     any(Trial[Trial %in% 1:6] %% 2 == 0),
    include_block2 = any(Trial[Trial %in% 8:13] %% 2 == 1) &
                     any(Trial[Trial %in% 8:13] %% 2 == 0)
  ) %>%
  ungroup() %>%
  dplyr::select(response_uuid, include_block1, include_block2) %>%
  distinct()

df_hh <- hh_enrollment$metrics %>% merge(data_include) %>%
  filter(
    (Trial == 7  & include_block1) |
    (Trial == 14 & include_block2)
  ) 
```

```{r hh-distinct}
df_hh %>% distinct() %>%
  dplyr::group_by(response_uuid)%>%
     summarise(n = n(), Age = first(Age)) %>% ungroup()%>% dplyr::select(Age, n)%>%
    tbl_summary(
      by   = Age,
      type = list(n ~ "continuous2"),
      statistic = list(
        all_continuous()  ~ c("{median} ({p25}, {p75})", "{min}, {max}"),
        all_categorical() ~ "{n} / {N} ({p}%)"
      ),
      digits       = all_continuous() ~ 2,
      missing_text = "(Missing)"
    ) %>% modify_caption("**Median (IQR) number of test trials with usable data (final analytic)**")
```

## Analysis

```{r hh-output-path}
write.csv(
    df_hh %>%
      dplyr::select(response_uuid, Age, Trial,target_prop),
    file.path(main_dir, "Computed_Data", "Aim1", "hh.csv"),
    row.names = FALSE
  )

tab_hh <- run_condition_model(
    data = df_hh,
    condition_var = "Age",
    metric = "target_prop",
    chance_level = 0.5,
    random_effects = c(
        "(1 | response_uuid)"
    ),
    interaction = FALSE
)
```


```{r hh-plot}

hh_fig <- df_hh %>% dplyr::group_by(response_uuid) %>% dplyr::summarise(helper_good_avg = mean(target_prop)) %>% merge(Part_Age,all.x=TRUE)  %>% dplyr::select(response_uuid, Age, helper_good_avg)%>% dplyr::mutate(Age = factor(Age, levels = c(6, 12)))

plot7_rise <- ggplot(data = hh_fig,
                     mapping = aes(x = Age,
                                   y = helper_good_avg,
                                   fill = Age)) +
  geom_flat_violin(scale = "count",
                   trim = FALSE) +
  stat_summary(fun.data = mean_sdl,
               fun.args = list(mult = 1),
               geom = "pointrange",
               position = position_nudge(0.05)) +
  geom_dotplot(binaxis = "y",
               dotsize = 0.6,
               stackdir = "down",
               position = position_nudge(-0.025)) +
  geom_hline(yintercept = 0.5, linetype = "dashed", color = "red") +
  stat_n_text(size = 4, y.pos = -0.2) +
  scale_fill_manual(values = c("lightblue3", "lightblue4")) +
  scale_y_continuous(breaks = c(0, 0.25, .50, .75, 1),
                     labels = c("0.00", "0.25", "0.50", "0.75", "1.00")) +
  coord_cartesian(ylim = c(-0.3, 1.15)) +   # zoom only; nothing is dropped
  labs(x = "Age",
       y = "Proportion of looks fixating on\nhelper stimuli\n") +
  theme_few() +
  theme(text = element_text(size = 15)) +
  guides(fill = "none")
```

