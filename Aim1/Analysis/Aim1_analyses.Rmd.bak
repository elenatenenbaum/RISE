```

Filter out trials 1 and 9. Participants must have at least 1 AEM trial in Block 2.
Must have usable data for at least 2 trials in block 1 for block 1 outcome to be included. Similarly for block 2.

```{r prediction-results}
# Filter out trials 1 and 9, then classify each trial as AEM or non-AEM
# based on whether target_prop > 0, and assign trials to Block 1 (trials 2-8)
# or Block 2 (remaining trials)

prediction_enr <- Prediction_enrollment$metrics %>% filter(!Trial %in% c("1","9")) %>%
  dplyr::mutate(aem = ifelse(target_prop > 0, "aem", "no aem")) %>% 
  dplyr::mutate(block = ifelse(Trial %in% as.character(2:8), "Block 1", "Block 2"))

# --- Block 2 Summary ---
df_b2 <- prediction_enr %>% 
  filter(block == "Block 2") %>%
  # Count AEM and non-AEM trials per participant
  dplyr::group_by(response_uuid, aem) %>% 
  dplyr::summarise(n = n()) %>% 
  ungroup() %>%
  # Ensure every participant has both AEM and non-AEM rows (fill missing with 0)
  tidyr::complete(response_uuid, aem) %>% 
  dplyr::mutate(n = ifelse(is.na(n), 0, n)) %>%
  # Compute total trials per participant, then calculate proportion of AEM trials
  dplyr::group_by(response_uuid) %>% 
  dplyr::mutate(n2 = sum(n)) %>% 
  filter(aem == "aem") %>% 
  dplyr::mutate(aem_prop = n / n2) %>% 
  # Merge in participant age information
  merge(Part_Age, all.x = T) %>%
  dplyr::mutate(block = "Block 2") %>%
  # Keep only participants who had at least 1 AEM trial in Block 2
  filter(n > 0)  

# --- Block 1 Summary ---
df_b1 <- prediction_enr %>% 
  filter(block == "Block 1") %>%
  # Count AEM and non-AEM trials per participant
  dplyr::group_by(response_uuid, aem) %>% 
  dplyr::summarise(n = n()) %>% 
  ungroup() %>%
  # Ensure every participant has both AEM and non-AEM rows (fill missing with 0)
  tidyr::complete(response_uuid, aem) %>% 
  dplyr::mutate(n = ifelse(is.na(n), 0, n)) %>%
  # Compute total trials per participant, then calculate proportion of AEM trials
  dplyr::group_by(response_uuid) %>% 
  dplyr::mutate(n2 = sum(n)) %>% 
  filter(aem == "aem") %>% 
  dplyr::mutate(aem_prop = n / n2) %>%
  # Merge in participant age information
  merge(Part_Age, all.x = T) %>%
  dplyr::mutate(block = "Block 1") %>%
  # Keep only participants who also appear in Block 2 (for matched comparison)
  filter(response_uuid %in% df_b2$response_uuid) 

prediction_final <- rbind(df_b1, df_b2) %>% 
  filter(n2 >= 2)
```

```{r prediction-final}
prediction_final %>% dplyr::select(1, Age, n2)  %>%
  dplyr::group_by(response_uuid)%>%
     summarise(n = sum(n2), Age = first(Age)) %>% dplyr::select(Age, n) %>%
    tbl_summary(
      by   = Age,
      type = list(n ~ "continuous2"),
      statistic = list(
        all_continuous()  ~ c("{median} ({p25}, {p75})", "{min}, {max}"),
        all_categorical() ~ "{n} / {N} ({p}%)"
      ),
      digits       = all_continuous() ~ 2,
      missing_text = "(Missing)"
    ) %>% modify_caption("**Median (IQR) number of test trials with usable data (final analytic)**")
```


