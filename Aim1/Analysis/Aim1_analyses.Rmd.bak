#only include response_uuid from id_merge

Stim_Order <- Stim_Order %>%
  filter(response_uuid %in% id_merge$response_uuid)

#check for duplicates
Stim_Order %>% group_by(child_hashed_id, frame_id) %>% filter(n() > 1) %>% ungroup() %>% distinct(child_hashed_id)
```

