# Prediction 
2 versions LthenR vs RthenL

Note on how outcome was derive:

1. Remove frames coded as "nobabyface", "noface", "none", or "away" 
2. Remove "left", "right" frames with confidence < 85%
3. Use "left" vs "right" to code "target" vs "non-target" depending on the task and version. For each test trials for each block (2-8) and (10-16), an AEM = if participant looks at target at all during critical window. 

For each block, compute total trials per participant, then calculate proportion of AEM trials as final outcome.

    
```{r prediciton-stim-order}
prediction<-Stim_Order %>% filter(grepl("Prediction", value))
prediction_icatcher <- merge(x=prediction,y=icatcher_output, 
             by=c("response_uuid","frame_id"), all=F) %>%
  anti_join(exclusion_df, by = c("response_uuid", "frame_id"))


prediction_icatcher <- prediction_icatcher %>% merge(df_diff) %>% mutate(
  frame_to_remove =
   round((record_1ststart * 1000) / 33.3)) %>% dplyr::select(1:6, frame_to_remove) %>% mutate(frame_to_remove = ifelse(is.na(frame_to_remove), 0, frame_to_remove)) %>% 
  mutate(value = gsub(".*/([^/]+)\\.webm$", "\\1", value))  %>% 
  dplyr::mutate(value = gsub("_Aim1", "", value))

prediction_icatcher$Version<- prediction_icatcher$value

```

```{r prediciton-timestamps}
labeled_frames_prediction <- read_xlsx(Aim1_timestamps_final,
  sheet = "Prediction")

labeled_frames_prediction <- labeled_frames_prediction %>%
  mutate(frame = map2(`Frame Start` , `Frame End`, seq)) %>%
  tidyr::unnest(frame) %>%
  mutate(Trial = str_extract(`Trial Number`, "\\d+")) %>%
  dplyr::select(frame, contains("PredictionTarget"), Trial) 

labeled_frames_prediction <- labeled_frames_prediction %>%
  mutate(PredictionTargetLthenR = case_when(
    PredictionTargetLthenR == "left"  ~ "right",
    PredictionTargetLthenR == "right" ~ "left",
    TRUE ~ PredictionTargetLthenR
  ))

labeled_frames_prediction <- labeled_frames_prediction %>%
  mutate(PredictionTargetRthenL = case_when(
    PredictionTargetRthenL == "left"  ~ "right",
    PredictionTargetRthenL == "right" ~ "left",
    TRUE ~ PredictionTargetRthenL
  ))
```

```{r prediciton-results}
Prediction_results <- process_icatcher(
    prediction_icatcher,
    labeled_frames_prediction,
    Part_Age,
    use_version = T
)
  
# main_dir must already be defined, e.g. main_dir <- "/path/to/project"
usable_frames_prediction <- Prediction_results$trial_counts %>%
  merge(Prediction_results$quality_flags %>% dplyr::select(-Age),
        by = c("response_uuid", "Trial"),
        all = TRUE) %>%
  dplyr::mutate(
    # NA noicatcherdata = no "no data" frames logged, so iCatcher data exists
    has_icatcher = is.na(noicatcherdata) | noicatcherdata != frames,
    noicatcherdata = tidyr::replace_na(noicatcherdata, 0),
    `Usable frames (%)` = round(count_85_non_na / frames, 3)
  ) %>%
  dplyr::select(response_uuid, Trial, `Usable frames (%)`, has_icatcher) %>%
  merge(prediction_icatcher %>% dplyr::select(response_uuid, icatcher_file_names),
        by = "response_uuid",
        all.x = TRUE)

write.csv(usable_frames_prediction,
          file.path(main_dir, "Computed_Data", "Aim1", "prediction_usableframe.csv"),
          row.names = FALSE)
```


